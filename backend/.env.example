GEMINI_API_KEY=
# Plain password or a bcrypt hash; used only to create the admin user on first start.
APP_PASSWORD=
# At least 32 bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=
PORT=8080
METRICS_ADDR=:9090
DATABASE_URL=postgres://postgres:postgres@localhost:5432/learning?sslmode=disable
DB_MAX_CONNS=10
ALLOWED_ORIGINS=http://localhost:5173
LOG_FORMAT=text
LOG_LEVEL=debug
